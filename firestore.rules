rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      let claims = request.auth.token;
      return claims.admin == true
        || claims.isAdmin == true;
    }

    function isSeniorPastor() {
      let claims = request.auth.token;
      return claims.seniorPastor == true
        || claims.isSeniorPastor == true;
    }

    function canWrite() {
      return isAdmin() || isSeniorPastor();
    }

    function canDelete() {
      return isAdmin();
    }

    function canSubmitExpenses() {
      let claims = request.auth.token;
      return isAuthenticated() && (
        isAdmin()
        || isSeniorPastor()
        || (claims.get('appAccess', []) is list && claims.get('appAccess', []).hasAny(['giving']))
      );
    }

    match /auditLogs/{logId} {
      allow create: if isAuthenticated() && canWrite();
      allow read: if isAuthenticated() && isAdmin();
      allow update, delete: if false;
    }

    match /people/{personId} {
      allow create: if isAuthenticated() && canWrite();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if isAuthenticated() && isSeniorPastor();
    }

    match /directoryIntakeSubmissions/{submissionId} {
      allow create: if request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.type is string
        && request.resource.data.type in ['Member', 'Volunteer', 'First Time', 'Returning', 'Guest', 'Child']
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName.size() > 0
        && (
          (
            request.resource.data.type == 'Child'
            && request.resource.data.parents is string
            && request.resource.data.parents.size() > 0
            && request.resource.data.parentPhone is string
            && request.resource.data.parentPhone.size() > 0
          )
          ||
          (
            request.resource.data.type != 'Child'
            && (
              (request.resource.data.email is string && request.resource.data.email.size() > 0)
              || (request.resource.data.phone is string && request.resource.data.phone.size() > 0)
            )
          )
        );
      allow read: if isAuthenticated() && canWrite();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if false;
    }

    match /expenseIntakeSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'submitterName', 'submitterEmail', 'submitterPhone', 'date', 'amount',
          'mainCategory', 'subcategory', 'description', 'payee', 'paymentMethod',
          'fund', 'reference', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'submitterName', 'submitterEmail', 'submitterPhone', 'date', 'amount',
          'mainCategory', 'subcategory', 'description', 'payee', 'paymentMethod',
          'fund', 'reference', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.submitterName is string
        && request.resource.data.submitterName.size() > 0
        && request.resource.data.submitterName.size() <= 120
        && request.resource.data.submitterEmail is string
        && request.resource.data.submitterEmail.size() <= 254
        && request.resource.data.submitterPhone is string
        && request.resource.data.submitterPhone.size() <= 30
        && (
          request.resource.data.submitterEmail.size() > 0
          || request.resource.data.submitterPhone.size() > 0
        )
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.mainCategory in ['Travel & Transportation', 'Ministries']
        && request.resource.data.subcategory is string
        && request.resource.data.subcategory.size() > 0
        && request.resource.data.subcategory.size() <= 100
        && (
          (
            request.resource.data.mainCategory == 'Travel & Transportation'
            && request.resource.data.subcategory in ['Transport', 'Travel']
          )
          || request.resource.data.mainCategory == 'Ministries'
        )
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 500
        && request.resource.data.payee is string
        && request.resource.data.payee.size() <= 160
        && request.resource.data.paymentMethod is string
        && request.resource.data.paymentMethod.size() <= 60
        && request.resource.data.fund is string
        && request.resource.data.fund.size() <= 120
        && request.resource.data.reference is string
        && request.resource.data.reference.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isAuthenticated() && canWrite();
      allow update: if isAuthenticated()
        && canWrite()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy is string
        && request.resource.data.reviewedBy.size() <= 120
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'approved'
            && request.resource.data.expenseId is string
            && request.resource.data.expenseId.size() > 0
            && request.resource.data.expenseId.size() <= 128
          )
          || (
            request.resource.data.status == 'rejected'
            && !('expenseId' in request.resource.data.keys())
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'expenseId', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ]);
      allow delete: if isAuthenticated()
        && canWrite()
        && resource.data.status in ['pending', 'rejected'];
    }

    match /events/{eventId} {
      allow create: if isAuthenticated() && canWrite();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if isAuthenticated() && canDelete();
    }

    match /giving/{giftId} {
      allow create: if isAuthenticated() && isAdmin();
      allow read: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /donations/{donationId} {
      allow create: if isAuthenticated() && isAdmin();
      allow read: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if isAuthenticated() && isAdmin();
    }

    match /expenses/{expenseId} {
      allow create: if canSubmitExpenses()
        && request.resource.data.keys().hasOnly([
          'date', 'amount', 'mainCategory', 'subcategory', 'description',
          'payee', 'paymentMethod', 'fund', 'reference', 'receiptKey',
          'receiptName', 'submittedBy', 'submittedByUid', 'status',
          'reviewedBy', 'reviewedAt', 'sourceIntakeId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'date', 'amount', 'mainCategory', 'subcategory', 'description',
          'submittedBy', 'submittedByUid', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.mainCategory in [
          'Personnel & Compensation',
          'Employee Benefits',
          'Facilities & Operations',
          'Property Insurance',
          'Travel & Transportation',
          'Missions',
          'Ministries'
        ]
        && request.resource.data.subcategory is string
        && request.resource.data.subcategory.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 500
        && request.resource.data.submittedBy is string
        && request.resource.data.submittedBy.size() <= 120
        && request.resource.data.submittedByUid == request.auth.uid
        && (
          (
            request.resource.data.status == 'pending'
            && !('reviewedBy' in request.resource.data.keys())
            && !('reviewedAt' in request.resource.data.keys())
            && !('sourceIntakeId' in request.resource.data.keys())
          )
          || (
            request.resource.data.status == 'approved'
            && canWrite()
            && request.resource.data.reviewedBy is string
            && request.resource.data.reviewedBy.size() <= 120
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.sourceIntakeId is string
            && request.resource.data.sourceIntakeId.size() > 0
            && request.resource.data.sourceIntakeId.size() <= 128
          )
        )
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.get('payee', '') is string
        && request.resource.data.get('payee', '').size() <= 160
        && request.resource.data.get('paymentMethod', '') is string
        && request.resource.data.get('paymentMethod', '').size() <= 60
        && request.resource.data.get('fund', '') is string
        && request.resource.data.get('fund', '').size() <= 120
        && request.resource.data.get('reference', '') is string
        && request.resource.data.get('reference', '').size() <= 120
        && (!('receiptKey' in request.resource.data.keys())
          || (
            request.resource.data.receiptKey is string
            && request.resource.data.receiptKey.size() <= 500
            && request.resource.data.receiptKey.matches('^financial-receipts/[A-Za-z0-9._-]+$')
          ))
        && (!('receiptName' in request.resource.data.keys())
          || (request.resource.data.receiptName is string && request.resource.data.receiptName.size() <= 160));
      allow read: if isAuthenticated() && canWrite();
      allow update: if isAuthenticated()
        && canWrite()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedBy is string
        && request.resource.data.reviewedBy.size() <= 120
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.get('reviewNote', '') is string
        && request.resource.data.get('reviewNote', '').size() <= 500
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'reviewNote', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /songs/{songId} {
      allow create: if isAuthenticated() && canWrite();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if isAuthenticated() && canDelete();

      match /analyses/{analysisId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && canWrite();
        allow delete: if isAuthenticated() && canWrite();
        allow update: if false;
      }
    }

    match /teams/{teamId} {
      allow create: if isAuthenticated() && canWrite();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if isAuthenticated() && canDelete();
    }

    match /workflows/{workflowId} {
      allow create: if isAuthenticated() && canWrite();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if isAuthenticated() && canDelete();
    }

    match /communityPosts/{postId} {
      allow create: if isAuthenticated() && canWrite();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if isAuthenticated() && (isAdmin() || (canWrite() && resource.data.authorId == request.auth.uid));
    }

    match /communityMessages/{messageId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.senderUid
        || canWrite()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderUid
        || isAdmin()
        || isSeniorPastor()
      );
    }

    match /teamMessages/{messageId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.senderUid
        || canWrite()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.senderUid
        || isAdmin()
        || isSeniorPastor()
        || (
          resource.data.teamId is string
          && resource.data.teamId.size() > 0
          && exists(/databases/$(database)/documents/teams/$(resource.data.teamId))
          && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.leadUid == request.auth.uid
        )
      );
    }

    match /workflowInboxMessages/{messageId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
      allow update, delete: if isAuthenticated() && canWrite();
    }

    match /settings/{settingId} {
      allow create: if isAuthenticated() && canWrite();
      allow read: if isAuthenticated() || settingId == 'financeExpenseCategories';
      allow update: if isAuthenticated() && canWrite();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated() && isAdmin();
    }

    match /userProfiles/{uid} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    match /dmThreads/{threadId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }
  }
}
